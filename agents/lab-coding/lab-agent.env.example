# Lab Agent 配置文件 —— DeepSeek 后端
# 复制本文件为 lab-agent.env，填入你的 DeepSeek API Key 即可。
#
# 密钥申请：https://platform.deepseek.com/api_keys （形如 sk-xxxxxxxx）

# ===== 必填：你的 DeepSeek API Key =====
ANTHROPIC_AUTH_TOKEN=sk-在此粘贴你的DeepSeek密钥
# ANTHROPIC_API_KEY 与 ANTHROPIC_AUTH_TOKEN 等价，二选一即可

# ===== DeepSeek 官方端点（默认）=====
# OpenAI 可改为：https://api.openai.com
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ===== 模型 =====
# deepseek-flash = DeepSeek-V4.1-Flash（推荐）
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash

# ===== 建议项 =====
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
API_TIMEOUT_MS=600000
CLAUDE_CODE_EFFORT_LEVEL=max

# ===== Security 文档链接（首次启动 Security 步骤）=====
# 换成你们正式文档地址；不设则用代码内默认占位
# LAB_SECURITY_URL=https://your-domain/docs/security

# ===== Lab 插件市场（接口已留；市场未就绪前请保持关闭）=====
# LAB_MARKETPLACE_ENABLED=1
# LAB_MARKETPLACE_REPO=your-org/lab-plugins
# LAB_MARKETPLACE_NAME=lab-plugins
# LAB_MARKETPLACE_DISPLAY_NAME=Lab marketplace
# 仅调试需要时才打开 Anthropic 官方市场：
# LAB_USE_ANTHROPIC_MARKETPLACE=1
