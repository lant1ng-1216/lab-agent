# Lab Agent 配置 —— 默认 DeepSeek（也可改 OpenAI）
# 复制本文件为 lab-agent.env，填入密钥即可。勿提交真实文件。
#
# DeepSeek 密钥：https://platform.deepseek.com/api_keys
# OpenAI 密钥：https://platform.openai.com/api-keys

# ===== 必填：API Key =====
DEEPSEEK_API_KEY=sk-在此粘贴你的密钥

# ===== 官方 Base URL（默认 DeepSeek）=====
# OpenAI 可改为：https://api.openai.com/v1
BASE_URL=https://api.deepseek.com

# ===== 模型（默认 DeepSeek Flash）=====
MODEL=deepseek-flash

# ===== 建议项 =====
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
API_TIMEOUT_MS=600000
CLAUDE_CODE_EFFORT_LEVEL=max

# ===== Security 文档链接（首次启动 Security 步骤）=====
# LAB_SECURITY_URL=https://your-domain/docs/security

# ===== Lab 插件市场（接口已留；市场未就绪前请保持关闭）=====
# LAB_MARKETPLACE_ENABLED=1
# LAB_MARKETPLACE_REPO=your-org/lab-plugins
# LAB_MARKETPLACE_NAME=lab-plugins
# LAB_MARKETPLACE_DISPLAY_NAME=Lab marketplace
