{
  "name": "lab-agent",
  "version": "0.1.7",
  "private": true,
  "description": "Lab Agent — open-source coding agent (Lab Code engine + desktop shell)",
  "author": "Lab Agent",
  "homepage": "https://github.com/lant1ng-1216/lab-agent",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "node scripts/dev.mjs desktop",
    "build": "tsc -p tsconfig.json && node scripts/copy-lab-coding.mjs && vite build",
    "prepare:engines": "node scripts/prepare-engines.mjs",
    "dist": "node scripts/dist.mjs",
    "verify:mac": "node scripts/verify-mac-sign.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "build": {
    "appId": "online.labagent.app",
    "productName": "Lab Agent",
    "copyright": "Copyright © Lab Agent contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "./scripts/after-pack.mjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "packaging/engine/darwin-arm64",
          "to": "lab-coding"
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "packaging/engine/win32-x64",
          "to": "lab-coding"
        }
      ]
    },
    "nsis": {
      "artifactName": "Lab-Agent-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "packaging/engine/linux-x64",
          "to": "lab-coding"
        }
      ],
      "artifactName": "Lab-Agent-${version}-linux-${arch}.${ext}"
    },
    "artifactName": "Lab-Agent-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.0.1",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "glimm": "^0.3.0",
    "maath": "^0.10.8",
    "node-pty": "^1.1.0",
    "postprocessing": "^6.37.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.175.0"
  }
}
